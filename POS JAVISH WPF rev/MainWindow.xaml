<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="POS JAVISH - Enterprise Point of Sale" 
        Height="768" Width="1366" 
        MinWidth="1024" MinHeight="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextElement.Foreground="{StaticResource PosText}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"        
        Background="{StaticResource PosBackground}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Background="{StaticResource PosPanel}" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/> <!-- Brand Width -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <materialDesign:PackIcon Kind="Store" Width="32" Height="32" Foreground="{StaticResource PosAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="POS JAVISH" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Page Title -->
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Dashboard" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0"/>

            <!-- User Info & Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                <!-- Scanner Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" Fill="#FF00FF00" Margin="0,0,8,0"/>
                    <TextBlock Text="Scanner Ready" Foreground="#FF00FF00" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Notifikasi" Foreground="{StaticResource PosText}">
                    <materialDesign:PackIcon Kind="Bell"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Bantuan" Foreground="{StaticResource PosText}">
                    <materialDesign:PackIcon Kind="HelpCircle"/>
                </Button>
                <Border Width="1" Height="24" Background="{StaticResource PosBorder}" Margin="10,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32" Foreground="{StaticResource PosTextMuted}"/>
                    <TextBlock x:Name="UserNameText" Text="-" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PosPanel}" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavList" SelectionChanged="OnNavSelectionChanged" Margin="10" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="16 12"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Foreground" Value="{StaticResource PosTextMuted}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PosAccent}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#334155"/> <!-- Hover Color -->
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Kasir">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Transaksi Kasir" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Produk">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Data Barang" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuPembelian" Tag="Pembelian">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CartArrowDown" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Stok Masuk" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuSupplier" Tag="Supplier">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TruckDelivery" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Supplier" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuExpense" Tag="Expense">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wallet" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Pengeluaran" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuLaporan" Tag="Laporan">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Laporan" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuShiftReport" Tag="ShiftReport" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Shift Report" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuTutupShift" Tag="TutupShift">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Tutup Shift" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuUser" Tag="UserManagement" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Manajemen User" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuLogPembelian" Tag="LogPembelian" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardTextClock" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Log Pembelian" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuStockHistory" Tag="StockHistory" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Riwayat Stok" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuLabaRugi" Tag="LabaRugi" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartAreaspline" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Laporan Laba Rugi" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Pengaturan">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,16,0"/>
                                <TextBlock Text="Pengaturan" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Trial Info & Logout -->
                    <StackPanel Grid.Row="1" Margin="20">
                        <!-- Trial Indicator -->
                        <materialDesign:Card x:Name="TrialInfoCard" Background="#441E1B" Padding="12" Margin="0,0,0,10" UniformCornerRadius="8" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <materialDesign:PackIcon Kind="AlertDecagram" Foreground="{StaticResource PosError}" Width="16" Height="16"/>
                                    <TextBlock Text="MODE DEMO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PosError}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TrialRemainingText" Text="Sisa: 100 Transaksi" FontSize="12" Foreground="White" Opacity="0.9"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="AKTIVASI" Height="24" Padding="0" Margin="0,8,0,0" Foreground="{StaticResource PosAccent}" FontSize="10" Click="ActivateTrial_Click"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <Button x:Name="LogoutBtn" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Foreground="{StaticResource PosError}" Click="LogoutBtn_Click" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Logout" Margin="0,0,16,0"/>
                                <TextBlock Text="Keluar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Column="1" x:Name="ContentRegion" Margin="20"/>
        </Grid>
    </Grid>
</Window>
