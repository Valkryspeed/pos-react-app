<UserControl x:Class="Views.TutupShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tutup Shift Kasir" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource PosText}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Shift Summary Cards -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Awal -->
                    <materialDesign:Card Grid.Column="0" Grid.Row="0" Margin="0,0,10,10" Padding="20" Background="{StaticResource PosPanel}" UniformCornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Modal Awal" Foreground="{StaticResource PosTextMuted}" FontSize="14"/>
                            <TextBlock x:Name="ModalAwalText" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Total Penjualan -->
                    <materialDesign:Card Grid.Column="1" Grid.Row="0" Margin="10,0,0,10" Padding="20" Background="{StaticResource PosPanel}" UniformCornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Total Penjualan" Foreground="{StaticResource PosTextMuted}" FontSize="14"/>
                            <TextBlock x:Name="TotalPenjualanText" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosSuccess}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Total Cash -->
                    <materialDesign:Card Grid.Column="0" Grid.Row="1" Margin="0,10,10,0" Padding="20" Background="{StaticResource PosPanel}" UniformCornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Total Cash" Foreground="{StaticResource PosTextMuted}" FontSize="14"/>
                            <TextBlock x:Name="TotalCashText" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosAccent}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Expected Cash -->
                    <materialDesign:Card Grid.Column="1" Grid.Row="1" Margin="10,10,0,0" Padding="20" Background="{StaticResource PosPanel}" UniformCornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Uang di Laci (Seharusnya)" Foreground="{StaticResource PosTextMuted}" FontSize="14"/>
                            <TextBlock x:Name="ExpectedCashText" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </StackPanel>

            <!-- Right: Closing Form -->
            <materialDesign:Card Grid.Column="1" Padding="20" Background="{StaticResource PosPanel}" UniformCornerRadius="10">
                <StackPanel>
                    <TextBlock Text="REKONSILIASI KAS" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource PosText}"/>
                    
                    <TextBlock Text="Input Uang Fisik di Laci" Foreground="{StaticResource PosTextMuted}" Margin="0,0,0,10"/>
                    <TextBox x:Name="UangFisikBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Rp 0" FontSize="24" Height="70" FontWeight="Bold"
                             materialDesign:TextFieldAssist.PrefixText="Rp "
                             TextChanged="UangFisikBox_TextChanged"
                             PreviewTextInput="NumberValidationTextBox"
                             Foreground="{StaticResource PosText}"/>

                    <Border x:Name="SelisihBorder" Margin="0,20,0,0" Padding="15" CornerRadius="8" Background="#33FFFFFF">
                        <StackPanel>
                            <TextBlock Text="Selisih" Foreground="{StaticResource PosTextMuted}" FontSize="14"/>
                            <TextBlock x:Name="SelisihText" Text="Rp 0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                            <TextBlock x:Name="SelisihStatusText" Text="OK" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnTutupShift" Content="TUTUP SHIFT DAN CETAK" Height="60" Margin="0,30,0,0"
                            Background="{StaticResource PosAccent}" BorderBrush="{StaticResource PosAccent}"
                            FontSize="18" Click="BtnTutupShift_Click"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>