<Window x:Class="Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Aktivasi POS JAVISH" Height="580" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PosBackground}"
        TextElement.Foreground="{StaticResource PosText}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Top">
            <materialDesign:PackIcon Kind="ShieldKey" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{StaticResource PosAccent}" Margin="0,0,0,20"/>
            
            <TextBlock Text="Aktivasi Aplikasi" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Silakan masukkan Serial Number untuk mengaktifkan fitur penuh." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,0,0,30"/>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Hardware ID Anda (Kirimkan kode ini ke Admin):" FontSize="12" Margin="0,0,0,5" Opacity="0.6"/>
                <Grid>
                    <TextBox x:Name="TxtHardwareId" Style="{StaticResource MaterialDesignOutlinedTextBox}" IsReadOnly="True" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PosAccent}"/>
                    <Button x:Name="BtnCopyId" Click="BtnCopyId_Click" Style="{StaticResource MaterialDesignIconButton}" HorizontalAlignment="Right" Margin="0,0,5,0" ToolTip="Salin Hardware ID">
                        <materialDesign:PackIcon Kind="ContentCopy"/>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="Serial Number:" FontSize="12" Margin="0,0,0,5" Opacity="0.6"/>
                <TextBox x:Name="TxtSerial" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         materialDesign:HintAssist.Hint="XXXX-XXXX-XXXX-XXXX"
                         FontSize="18" FontWeight="Bold" TextAlignment="Center" CharacterCasing="Upper"
                         Foreground="{StaticResource PosText}" CaretBrush="{StaticResource PosText}"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="NANTI SAJA" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" Click="BtnLater_Click"/>
                <Button Grid.Column="1" x:Name="BtnActivate" Content="AKTIVASI SEKARANG" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PosAccent}" BorderBrush="{StaticResource PosAccent}" Click="BtnActivate_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
