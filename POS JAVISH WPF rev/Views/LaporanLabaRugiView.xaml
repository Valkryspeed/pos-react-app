<UserControl x:Class="Views.LaporanLabaRugiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Laporan Laba Rugi" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" Foreground="{StaticResource PosText}"/>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <materialDesign:PackIcon Kind="Calendar" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource PosTextMuted}"/>
            <DatePicker x:Name="StartDatePicker" Grid.Column="1" Margin="0,0,15,0" 
                        materialDesign:HintAssist.Hint="Mulai Tanggal" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
            <DatePicker x:Name="EndDatePicker" Grid.Column="2" Margin="0,0,15,0"
                        materialDesign:HintAssist.Hint="Sampai Tanggal" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
            <Button Grid.Column="3" Content="Tampilkan" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Click="TampilkanBtn_Click" Background="{StaticResource PosAccent}" BorderBrush="{StaticResource PosAccent}"/>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Revenue -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="15" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Penjualan" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                    <TextBlock x:Name="TotalRevenueText" Text="Rp 0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosSuccess}" Margin="0,5,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- COGS (Modal) -->
            <materialDesign:Card Grid.Column="1" Margin="0,0,10,0" Padding="15" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Modal (HPP)" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                    <TextBlock x:Name="TotalCogsText" Text="Rp 0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosError}" Margin="0,5,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Gross Profit -->
            <materialDesign:Card Grid.Column="2" Margin="0,0,10,0" Padding="15" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Laba Kotor" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                    <TextBlock x:Name="GrossProfitText" Text="Rp 0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosAccent}" Margin="0,5,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Expenses -->
            <materialDesign:Card Grid.Column="3" Margin="0,0,10,0" Padding="15" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Pengeluaran" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                    <TextBlock x:Name="TotalExpensesText" Text="Rp 0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosError}" Margin="0,5,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Net Profit -->
            <materialDesign:Card Grid.Column="4" Padding="15" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Laba Bersih" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                    <TextBlock x:Name="NetProfitText" Text="Rp 0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Detailed Breakdown -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Profit Per Item -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,15,0" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1" Padding="15">
                        <TextBlock Text="Laba per Barang" FontWeight="Bold" Foreground="{StaticResource PosText}"/>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="ItemProfitGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barang" Binding="{Binding NamaBarang}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60"/>
                            <DataGridTextColumn Header="Penjualan" Binding="{Binding TotalRevenue, StringFormat=C0}" Width="110"/>
                            <DataGridTextColumn Header="Modal" Binding="{Binding TotalCogs, StringFormat=C0}" Width="110"/>
                            <DataGridTextColumn Header="Laba" Binding="{Binding Profit, StringFormat=C0}" Width="110" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PosSuccess}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Expenses Breakdown -->
            <materialDesign:Card Grid.Column="1" Background="{StaticResource PosPanel}" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1" Padding="15">
                        <TextBlock Text="Daftar Pengeluaran" FontWeight="Bold" Foreground="{StaticResource PosText}"/>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="ExpensesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="*"/>
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah, StringFormat=C0}" Width="120" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>