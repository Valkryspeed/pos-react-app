<UserControl x:Class="Views.KasirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/> <!-- Reduced from 380 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Input & Search -->
            <Border Grid.Column="0" Background="{StaticResource PosPanel}" Margin="0,0,15,0" CornerRadius="8" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Input Produk" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,20" Foreground="{StaticResource PosText}"/>

                    <StackPanel Grid.Row="1">
                        <!-- Barcode Input -->
                        <TextBox x:Name="KodeInput" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Scan Barcode / Kode"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Margin="0,0,0,16" FontSize="18" Height="50" KeyDown="KodeInput_KeyDown"
                                 Foreground="{StaticResource PosText}" 
                                 CaretBrush="{StaticResource PosText}"/>

                        <Button x:Name="AddBtn" Content="TAMBAH" Style="{StaticResource MaterialDesignRaisedButton}" Height="55" FontSize="18" Click="AddBtn_Click" Margin="0,0,0,25" Background="{StaticResource PosAccent}" BorderBrush="{StaticResource PosAccent}"/>

                        <Separator Margin="0,0,0,20" Background="{StaticResource PosBorder}"/>
                        
                        <TextBlock Text="Cari Manual" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,10" Foreground="{StaticResource PosTextMuted}"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ketik Nama Produk..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 TextChanged="SearchBox_TextChanged"
                                 Foreground="{StaticResource PosText}"
                                 CaretBrush="{StaticResource PosText}"/>
                    </StackPanel>
                    
                    <!-- Search Results List -->
                    <ListBox x:Name="SearchResultsList" Grid.Row="2" Margin="0,20,0,0" SelectionChanged="SearchResultsList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border" Padding="8" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PosAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NamaBarang}" FontWeight="Bold" Foreground="{StaticResource PosText}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding KodeBarang}" FontSize="12" Foreground="{StaticResource PosTextMuted}"/>
                                            <Border CornerRadius="4" Padding="4,0" Margin="10,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStokHabis}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PosError}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStokMenipis}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PosWarning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StokStatus}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding HargaJual, StringFormat=C0}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PosSuccess}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel: Cart -->
            <Border Grid.Column="1" Background="{StaticResource PosPanel}" CornerRadius="8" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Grid Grid.Row="0" Margin="0" Background="{StaticResource PosBackground}" Height="60">
                        <TextBlock Text="Keranjang Belanja" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PosText}"/>
                    </Grid>

                    <!-- Cart Items -->
                    <DataGrid Grid.Row="1" x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0"
                              BorderThickness="0" Background="Transparent"
                              materialDesign:DataGridAssist.CellPadding="8 8 8 8" 
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding KodeBarang}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Nama Barang" Binding="{Binding NamaBarang}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Qty" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-" Width="28" Height="28" Padding="0" Focusable="False" Style="{StaticResource MaterialDesignOutlinedButton}" Click="QtyMinus_Click" BorderBrush="{StaticResource PosBorder}" Foreground="{StaticResource PosText}"/>
                                            <TextBlock Text="{Binding Qty}" Margin="8,0" VerticalAlignment="Center" Width="25" TextAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                            <Button Content="+" Width="28" Height="28" Padding="0" Focusable="False" Style="{StaticResource MaterialDesignOutlinedButton}" Click="QtyPlus_Click" BorderBrush="{StaticResource PosBorder}" Foreground="{StaticResource PosText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Harga" Binding="{Binding HargaJual, StringFormat=C0}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PosAccent}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Focusable="False" Foreground="{StaticResource PosError}" Click="DeleteRow_Click" ToolTip="Hapus Item">
                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer: Totals & Actions -->
                    <Border Grid.Row="2" Padding="20" Background="{StaticResource PosBackground}" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="350"/>
                            </Grid.ColumnDefinitions>

                            <!-- Actions -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Diskon Manual" Click="Discount_Click" Height="45" Foreground="{StaticResource PosText}" BorderBrush="{StaticResource PosBorder}"/>
                            </StackPanel>

                            <!-- Totals -->
                            <StackPanel Grid.Column="1">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Subtotal" Foreground="{StaticResource PosTextMuted}"/>
                                    <TextBlock x:Name="SubtotalText" Text="Rp 0" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource PosText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Diskon" Foreground="{StaticResource PosTextMuted}"/>
                                    <TextBlock x:Name="DiskonText" Text="Rp 0" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource PosError}"/>
                                </Grid>
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="Total Besar" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosText}"/>
                                    <TextBlock x:Name="TotalText" Text="Rp 0" HorizontalAlignment="Right" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PosAccent}"/>
                                </Grid>
                                
                                <TextBox x:Name="BayarBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                         materialDesign:HintAssist.Hint="Bayar (Rp)" FontSize="20" Margin="0,0,0,15"
                                         TextChanged="BayarBox_TextChanged" KeyDown="BayarBox_KeyDown"
                                         GotFocus="BayarBox_GotFocus" PreviewMouseLeftButtonDown="BayarBox_PreviewMouseLeftButtonDown"
                                         Foreground="{StaticResource PosText}"
                                         CaretBrush="{StaticResource PosText}"/>
                                
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="Kembalian" FontSize="16" Foreground="{StaticResource PosTextMuted}"/>
                                    <TextBlock x:Name="KembalianText" Text="Rp 0" HorizontalAlignment="Right" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosSuccess}"/>
                                </Grid>

                                <Button Content="BAYAR SEKARANG" Height="60" FontSize="20" Click="PayBtn_Click" Background="{StaticResource PosSuccess}" BorderBrush="{StaticResource PosSuccess}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=BayarBox}" Value="">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Shortcut Bar -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,5" Background="{StaticResource PosPanel}" CornerRadius="4" BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Border Background="{StaticResource PosBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
                        <TextBlock Text="F1" FontWeight="Bold" Foreground="{StaticResource PosAccent}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Scan Barang" VerticalAlignment="Center" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Border Background="{StaticResource PosBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
                        <TextBlock Text="F2" FontWeight="Bold" Foreground="{StaticResource PosAccent}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Input Bayar" VerticalAlignment="Center" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Border Background="{StaticResource PosBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
                        <TextBlock Text="F5" FontWeight="Bold" Foreground="{StaticResource PosAccent}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Tambah Manual" VerticalAlignment="Center" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <Border Background="{StaticResource PosBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
                        <TextBlock Text="Del" FontWeight="Bold" Foreground="{StaticResource PosError}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Hapus Item" VerticalAlignment="Center" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource PosBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
                        <TextBlock Text="F12" FontWeight="Bold" Foreground="{StaticResource PosSuccess}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Bayar Sekarang" VerticalAlignment="Center" Foreground="{StaticResource PosTextMuted}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>