<UserControl x:Class="Views.PembelianView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Input Barang Masuk -->
        <Border Grid.Column="0" Background="{StaticResource PosPanel}" Margin="0,0,15,0" CornerRadius="8" Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Input Pembelian" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,20" Foreground="{StaticResource PosText}"/>

                <StackPanel Grid.Row="1">
                    <!-- Cari Barang -->
                    <TextBlock Text="Cari Barang" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,5" Foreground="{StaticResource PosTextMuted}"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Ketik Nama / Kode Barang"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Margin="0,0,0,10" TextChanged="SearchBox_TextChanged"
                             Foreground="{StaticResource PosText}"
                             CaretBrush="{StaticResource PosText}"/>
                    
                    <!-- Hasil Pencarian -->
                    <ListBox x:Name="SearchResultsList" MaxHeight="150" Margin="0,0,0,20" SelectionChanged="SearchResultsList_SelectionChanged" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border" Padding="8" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PosAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding NamaBarang}" FontWeight="Bold" Foreground="{StaticResource PosText}"/>
                                    <TextBlock Text="{Binding KodeBarang}" FontSize="11" Foreground="{StaticResource PosTextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Detail Barang Terpilih -->
                    <Border Background="{StaticResource PosBackground}" Padding="15" CornerRadius="4" Margin="0,0,0,20" x:Name="SelectedItemPanel" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="SelectedNameText" Text="Nama Barang" FontWeight="Bold" Foreground="{StaticResource PosText}" FontSize="16"/>
                            <TextBlock x:Name="SelectedCodeText" Text="Kode: 12345" FontSize="12" Foreground="{StaticResource PosTextMuted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Stok Saat Ini: " FontSize="12" Foreground="{StaticResource PosTextMuted}"/>
                                <TextBlock x:Name="SelectedStockText" Text="10" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PosAccent}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Input Harga Beli & Qty -->
                    <TextBlock Text="Harga Beli (Satuan)" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,5" Foreground="{StaticResource PosTextMuted}"/>
                    <TextBox x:Name="HargaBeliBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Rp 0"
                             Margin="0,0,0,15"
                             Foreground="{StaticResource PosText}"
                             CaretBrush="{StaticResource PosText}"/>

                    <TextBlock Text="Jumlah Masuk (Qty)" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,5" Foreground="{StaticResource PosTextMuted}"/>
                    <TextBox x:Name="QtyBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="0"
                             Margin="0,0,0,25"
                             Foreground="{StaticResource PosText}"
                             CaretBrush="{StaticResource PosText}"/>

                    <Button x:Name="AddBtn" Content="TAMBAH KE DAFTAR" Style="{StaticResource MaterialDesignRaisedButton}" Height="50" Click="AddBtn_Click" Background="{StaticResource PosAccent}" BorderBrush="{StaticResource PosAccent}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Panel: Daftar Pembelian -->
        <Border Grid.Column="1" Background="{StaticResource PosPanel}" CornerRadius="8" Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0" Background="{StaticResource PosBackground}" Height="60">
                    <TextBlock Text="Daftar Barang Masuk" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PosText}"/>
                </Grid>

                <!-- List Items -->
                <DataGrid Grid.Row="1" x:Name="PurchaseGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0"
                          BorderThickness="0" Background="Transparent"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8" 
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding KodeBarang}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nama Barang" Binding="{Binding NamaBarang}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Harga Beli" Binding="{Binding HargaBeli, StringFormat=C0}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PosAccent}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource PosError}" Click="DeleteRow_Click" ToolTip="Hapus Item">
                                        <materialDesign:PackIcon Kind="Delete"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer: Supplier & Save -->
                <Border Grid.Row="2" Padding="20" Background="{StaticResource PosBackground}" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <!-- Kiri: Info Supplier & Faktur -->
                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="Informasi Supplier" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource PosText}"/>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SupplierCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Pilih Supplier"
                                          DisplayMemberPath="Nama" SelectedValuePath="Id"
                                          Foreground="{StaticResource PosText}"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" Margin="10,0,0,0" ToolTip="Tambah Supplier Baru" Click="AddSupplier_Click" Foreground="{StaticResource PosAccent}">
                                    <materialDesign:PackIcon Kind="PlusCircle" Width="24" Height="24"/>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FakturBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="No. Faktur"
                                         Margin="0,0,10,0"
                                         Foreground="{StaticResource PosText}"
                                         CaretBrush="{StaticResource PosText}"/>
                                
                                <DatePicker x:Name="TanggalPicker" Grid.Column="1" 
                                            materialDesign:HintAssist.Hint="Tanggal Pembelian" 
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Foreground="{StaticResource PosText}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Kanan: Total & Simpan -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Total Pembelian" FontSize="16" Foreground="{StaticResource PosTextMuted}"/>
                                <TextBlock x:Name="TotalText" Text="Rp 0" HorizontalAlignment="Right" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosAccent}"/>
                            </Grid>

                            <Button Content="SIMPAN TRANSAKSI" Height="50" FontSize="16" Click="SaveBtn_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PosSuccess}" BorderBrush="{StaticResource PosSuccess}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>