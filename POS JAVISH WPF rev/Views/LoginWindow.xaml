<Window x:Class="Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login" Width="420" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border Background="{StaticResource PosBackground}" Padding="24">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Masuk ke POS" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" Foreground="{StaticResource PosText}"/>

        <StackPanel Grid.Row="1">
            <TextBox x:Name="UsernameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                     materialDesign:HintAssist.Hint="Username" Margin="0,0,0,12" Foreground="#FFF3E9E9" FontSize="14"/>
            <PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="Password" 
                         Margin="0,0,0,24" Foreground="#FFF3E6E6" FontSize="14" />
            <Button x:Name="LoginBtn" Content="LOGIN" Height="44" 
                    Background="{StaticResource PosAccent}" Foreground="White"
                    Click="LoginBtn_Click" IsDefault="True" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="© POS JAVISH" 
                   Opacity="0.6" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </Grid>
    </Border>
</Window>
